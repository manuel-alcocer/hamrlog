/* hamrlog layout.
   Vertical stack: status, history (flexible), entry, counters.
   The history panel is the only widget that grows, so the entry line always
   stays at the same place on screen no matter the terminal size. */

Screen {
    layout: vertical;
    background: $surface;
}

/* Exactly one row: a border here would consume the only line available,
   so the separation from the history panel is done with background colour. */
#statusline {
    height: 1;
    background: $primary-darken-3;
    color: $text;
    padding: 0 1;
}

/* The log and its detail share one framed area, so it reads as a single
   panel with two halves rather than two unrelated widgets. */
#log-frame {
    height: 1fr;
    min-height: 8;
    border: round $primary-darken-2;
    border-title-color: $accent;
    border-title-align: left;
    padding: 0;
}

#history {
    height: 1fr;
    min-height: 3;
    border: none;
    background: $surface;
}

/* Fixed height: three lines of detail plus the rule above them. Padding
   only on the sides, or the third line would fall outside. */
#detail {
    height: 4;
    padding: 0 1;
    border-top: solid $primary-darken-2;
    background: $surface;
}

#history > .datatable--header {
    background: $panel;
    color: $text;
    text-style: bold;
}

/* The history never holds focus, so its cursor must stay clearly visible
   anyway: it is what the arrow keys move from the entry line. */
#history > .datatable--cursor,
#history > .datatable--hover {
    background: $primary;
    color: $text;
    text-style: bold;
}

#entry {
    height: auto;
    border-top: solid $primary-darken-2;
    background: $boost;
    padding: 0;
}

/* One row of boxes, each labelled. The free-text field takes what is left,
   so the form fills the width without wrapping. */
#entry-fields {
    height: 1;
    width: 100%;
}

/* Frequency and mode, shown only while editing a logged QSO. */
#entry-extra {
    height: 1;
    width: 100%;
}

.entry-label {
    height: 1;
    padding: 0 1 0 1;
    color: $text-muted;
    text-style: bold;
}

.entry-field {
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
}

.entry-field:focus {
    background: $primary-darken-2;
    text-style: bold;
}

/* Browsing the log: the form is replaced by a bar of actions, which has to
   look unmistakably different from a field waiting for a callsign. */
#entry-browse {
    height: 1;
    background: $warning-darken-3;
    color: $text;
}

#entry-hint,
#entry-feedback {
    height: 1;
    padding: 0 1;
}

#stats {
    height: 1;
    background: $panel;
    padding: 0 1;
}

/* ----------------------------------------------------------- panels ---- */

/* Dialogs are drawn in place of the log (see PanelScreen), framed like it, so
   they read as another view of the main panel rather than a floating box.
   Size and position are set in code; the widths below only matter until
   then. */
.modal {
    width: 84;
    height: auto;
    padding: 0 1;
    background: $surface;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    border-title-align: left;
}

/* Transparent: everything around the panel stays in view, undimmed. */
PanelScreen {
    align: left top;
    background: transparent;
}

.modal-title {
    width: 100%;
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

.modal-subtitle {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}

.modal-help {
    width: 100%;
    color: $text-muted;
    text-style: italic;
    padding-top: 1;
}

.modal-buttons {
    height: auto;
    width: 100%;
    align-horizontal: right;
    padding-top: 1;
}

/* Flat, one line high: the panel is one frame, with no boxes inside it. */
.modal-buttons Button {
    margin-left: 2;
    border: none;
    height: 1;
    min-width: 14;
}

/* Text boxes look like the entry line's: one row, told apart by colour. */
.modal Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
}

.modal Input:focus {
    background: $primary-darken-2;
    text-style: bold;
}

/* ------------------------------------------------------------ forms ---- */

/* Takes what the panel has left and scrolls, so the buttons below it are
   never pushed out of view. */
.form-body {
    height: 1fr;
}

.form-row {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

.form-label {
    width: 22;
    padding: 0 1 0 0;
    color: $text-muted;
}

.form-input {
    width: 1fr;
}

.form-readonly {
    padding: 0 1;
    color: $text-muted;
}

.form-error {
    width: 100%;
    height: auto;
    color: $error;
}
