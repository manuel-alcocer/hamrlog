# Command line, Prometheus exporter and REST API.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

# Arguments (cli.py).
msgid "Amateur radio logbook for the console (Linux, Windows and macOS)."
msgstr "Diario de radioaficionado para consola (Linux, Windows y macOS)."

msgid "SQLAlchemy URL of the database (local SQLite by default)."
msgstr "URL SQLAlchemy de la base de datos (por defecto, SQLite local)."

msgid "Open the text interface (default)."
msgstr "Abre la interfaz de texto (por defecto)."

msgid "Show paths, database and version."
msgstr "Muestra rutas, base de datos y versión."

msgid "Export the log without opening the interface."
msgstr "Exporta el log sin abrir la interfaz."

msgid "Destination file."
msgstr "Fichero de destino."

msgid "Output format."
msgstr "Formato de salida."

msgid "Import an ADIF file."
msgstr "Importa un fichero ADIF."

msgid ".adi file to import."
msgstr "Fichero .adi a importar."

msgid "Callsign of the target operator."
msgstr "Indicativo del operador de destino."

msgid "Assign every contact to the given operator, ignoring the one in the file."
msgstr "Asigna todos los contactos al operador indicado, ignorando el del fichero."

msgid "Start only the Prometheus exporter."
msgstr "Arranca solo el exportador Prometheus."

msgid "HTTP port."
msgstr "Puerto HTTP."

msgid "Contact address book."
msgstr "Agenda de contactos (listín)."

msgid "Import a contact list (CSV or JSON, format detected)."
msgstr "Importa una lista de contactos (CSV o JSON, formato detectado)."

msgid "File to import."
msgstr "Fichero a importar."

msgid "Import only the given country, e.g. Spain."
msgstr "Importar solo el país indicado, p. ej. Spain."

msgid "Leave alone the contacts already in the address book."
msgstr "No tocar los contactos que ya están en la agenda."

msgid "Export the address book."
msgstr "Exporta la agenda."

msgid "Search the address book."
msgstr "Busca en la agenda."

msgid "Text to search for."
msgstr "Texto a buscar."

msgid "Maximum number of rows."
msgstr "Máximo de filas."

# Output (cli.py).
msgid "Database      : {value}"
msgstr "Base de datos : {value}"

msgid "Data          : {value}"
msgstr "Datos         : {value}"

msgid "Configuration : {value}"
msgstr "Configuración : {value}"

msgid "Exports       : {value}"
msgstr "Exportaciones : {value}"

msgid "Exported {count} contacts to {path}"
msgstr "{count} contactos exportados a {path}"

msgid "There is no operator {callsign}."
msgstr "No existe el operador {callsign}."

msgid "Detected format: {name}"
msgstr "Formato detectado: {name}"

msgid "warning: {warning}"
msgstr "aviso: {warning}"

msgid "Contacts without a DMR ID are not exported: the radio ignores them."
msgstr "Los contactos sin ID DMR no se exportan: la radio los ignora."

msgid "No results."
msgstr "Sin resultados."

msgid "The address book is empty."
msgstr "La agenda está vacía."

msgid "CALLSIGN"
msgstr "INDICATIVO"

msgid "NAME"
msgstr "NOMBRE"

msgid "CITY"
msgstr "CIUDAD"

msgid "{shown} of {total} contacts."
msgstr "{shown} de {total} contactos."

# Prometheus exporter (api/metrics.py).
msgid "Install the metrics extra: pip install hamrlog[metrics]"
msgstr "Instala el extra de métricas: pip install hamrlog[metrics]"

msgid "Prometheus exporter at http://localhost:{port}/metrics  (Ctrl+C to quit)"
msgstr "Exportador Prometheus en http://localhost:{port}/metrics  (Ctrl+C para salir)"

# REST API (api/server.py).
msgid "The API needs the extra: pip install hamrlog[api]"
msgstr "La API necesita el extra: pip install hamrlog[api]"

msgid "Contact not found"
msgstr "Contacto no encontrado"
