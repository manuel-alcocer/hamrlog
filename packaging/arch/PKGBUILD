# Maintainer: Manuel Alcocer <manuel@alcocer.net>
pkgname=hamrlog
pkgver=0.1.0
pkgrel=1
pkgdesc="Diario de contactos para radioaficionados, en modo texto"
arch=('any')
url="https://github.com/manuel-alcocer/hamrlog"
license=('MIT')
depends=('python' 'python-textual' 'python-sqlalchemy')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
optdepends=(
  'python-prometheus_client: exportador de métricas Prometheus'
  'python-fastapi: API REST de solo lectura'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # Needs the runtime dependencies as well as pytest, which are absent under
  # makepkg --nodeps. Skipped rather than failed, so the package still builds.
  if python -c 'import pytest, sqlalchemy, textual' 2>/dev/null; then
    PYTHONPATH=src python -m pytest -q
  else
    echo "==> Dependencias de prueba ausentes, se omite la comprobación"
  fi
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/arquitectura.md "$pkgdir/usr/share/doc/$pkgname/arquitectura.md"
}
